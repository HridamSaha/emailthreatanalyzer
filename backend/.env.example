# Copy to .env and adjust. Never commit real secrets.
APP_NAME=Email Threat Analysis and Malware Detection System
APP_VERSION=1.0.0
APP_ENV=development
DATABASE_URL=sqlite:///./data/etas.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
PERSIST_RAW_CONTENT=false
RATE_LIMIT_ANALYZE_PER_MINUTE=30

# Optional scoring thresholds (inclusive upper bounds for Safe and Suspicious)
SCORE_SAFE_MAX=29
SCORE_SUSPICIOUS_MAX=59

# Optional VirusTotal hash/URL reputation (leave empty to disable)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# Optional ClamAV daemon
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# Optional YARA rules directory
YARA_RULES_PATH=./yara_rules

# Optional admin token for enabling/disabling rules (leave empty to allow local lab mode)
ADMIN_API_TOKEN=
